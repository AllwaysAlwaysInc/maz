# Supabase Cloud Ledger
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Treasury & EVM RPC (Base Sepolia 84532 -> Base Mainnet 8453)
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Optional Coinbase Developer Platform (CDP) Keys
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Optional Local Founder Admin Unlock
FOUNDER_ADMIN_EMAIL=you@example.com
FOUNDER_ADMIN_PASSCODE=change-me
